<AlipayView="alipayView"
	<Image="bgImage", fit="Full", image="tongyongbeijing.jpg", touch=1>
	<Image="centerImage", image="tongyongbeijingkuang.png", layout="Center", offset=[0,8]
		<Image="rateTipImg", image="rate10.png", layout="RightUpOut", offset=[-100,-5], scale=0.8>

		<Image="tbvBgImg", image="chongzhiduanxintiao.png", layout="Center", offset=[0,-55]
			<TableView="tbv", layout="Center", size=[633,154], cell="vNotePayDlgCell.vui">

			<Text="yp_noText", text="请输入充值金额：", fontSize=18, color=[90,40,0], layout="LeftDownOut", offset=[50,35]>
			<Editor="rc_cardIdEditor", bgImage="chongzhishurukuang.png", relative="yp_noText", fontSize=25, size=[196,34], fontColor=[90,40,0], inputMode=2, layout="RightOut", offset=[0,0], pFontColor=[163,125,84], text="10">
			<Button="sureBtn", image="anniu7.png", topImage="queding.png", layout="RightOut", offset=[10,0], onClick="node:Parent(3):onPayBtnClick()", relative="rc_cardIdEditor">
		>
		<Text="tipText", text="充值金额", layout="UpOut", relative="tbvBgImg", offset=[0,0], color=[90,40,0]>

		
	>
	<Image="titleImage", image="tongyongbiaotidi.png", layout="LetfUp", offset=[124,0]
		<Image="titliText", image="congzhi.png", layout="Center", offset=[5,-12]>
	>
	<Button="backBtn", image="fanhui.png", layout="UpRight", offset=[-7,5], onClick="node:Parent(1):doPop()">
>