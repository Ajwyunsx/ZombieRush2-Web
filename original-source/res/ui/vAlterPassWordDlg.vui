<AlterPassWordDlg="alterPassWordDlg"
	<Image="bgImage", fit="Full", image="tongyongbeijing.jpg", touch=1>
	<Image="titleImage1", image="tongyongbiaotidi.png", layout="Up", visible=0>
	
	<Image="imgBackGroundAlterPassWord", image="tongyongbeijingkuang.png", relative="titleImage1", layout="Down", step=[0,1], offset=[0,-34]
		<Layer="lyrStep1", layout="Up", fill=[1,0.27]
			<Editor="edtOldPassWordAlterPassWord", bgImage="shurukuang.png", text="", placeHolder="请输入不超过16个字符", fontSize=22, maxLegth=16, layout="Down", size=[380,40], offset=[30,0], pFontColor=[157,119,80], align="Left", pFont="Arial", pFontSize=26>
			<Text="txOldPassWordAlterPassWord", text="旧密码：", layout="LeftOut", fontSize=24, relative="edtOldPassWordAlterPassWord", offset=[-4,0], color=[85,17,0]>
		>
		<Layer="lyrStep2", layout="Down", relative="lyrStep1", step=[0,1], fill=[1,0.2], offset=[0,18]
			<Editor="edtNewPassWordAlterPassWord", bgImage="shurukuang.png", text="", placeHolder="请输入不超过16个字符", fontSize=22, maxLegth=16, layout="Center", size=[380,40], offset=[30,0], pFontColor=[157,119,80], align="Left", pFont="Arial", pFontSize=26>
			<Text="txNewPassWordAlterPassWord", text="新密码：", layout="LeftOut", fontSize=24, relative="edtNewPassWordAlterPassWord", offset=[-4,0], color=[85,17,0]>
		>

		<Layer="lyrStep3", layout="Down", relative="lyrStep2", step=[0,1], fill=[1,0.2]
			<Editor="edtPassWordTAlterPassWord", bgImage="shurukuang.png", text="", placeHolder="请输入不超过16个字符", fontSize=22, maxLegth=16, layout="Center", size=[380,40], offset=[30,0], pFontColor=[157,119,80], align="Left", pFont="Arial", pFontSize=26>
			<Text="txPassWordTAlterPassWord", text="确认新密码：", layout="LeftOut", fontSize=24, relative="edtPassWordTAlterPassWord", offset=[-4,0], color=[85,17,0]>
		>

		<Button="btnSaveAlterPassWord", image="anniu7.png", layout="Down", relative="lyrStep3", step=[0,1], offset=[0,0], onClick="node:Parent(2):onSaveClick()"
			<Image="imgSaveAlterPassWord", image="baocunxiugai.png", layout="Center">
		>
	>

	<Image="imgzhubiaotouAlterPassWord", image="tongyongbiaotidi.png", layout="LetfUp", offset=[124,0]
		<Image="imgTitleTAlterPassWord", layout="Center", image="xiugaimima.png", offset=[5,-10]>
	>
	<Button="btnCloseAlterPassWord", layout="RightUp", image="fanhui.png", relative="imgBackGroundAlterPassWord", step=[0.3,-0.5], offset=[0,0], onClick="node:Parent():onCloseClick()">
>