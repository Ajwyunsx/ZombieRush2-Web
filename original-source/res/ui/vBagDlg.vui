<BagDlg="bagDlg"
	<Image="bgImage", touch=1, fit="Full", image="tongyongbeijing.jpg">

	
	
	<Layer="lyrBagBag",layout="Center",fill=[1,1]
		<Layer="lyShowBag", size=[698,385],layout="Down", offset=[45,-25]
			<Image="imgMuLShop",image="zuocemutiao.png",layout="LeftUp", offset=[-42,42]>
			<Image="imgMuRShop",image="youcemutiao.png",layout="RightUp", offset=[37,34]>
			
			<Text="txNoneBag",text="没有物品",layout="Center",visible=0>
			
			<Button="btnGiftsBag",image="mubanweixuanzhong.png",layout="Right",offset=[-688,-57],onClick="node:Parent(3):ChageTableB('GIFTS')"
				<Image="imgAllBag",image="libao2.png",layout="Center">
			>
			<Button="btnPropertyBag",image="mubanxuanzhong.png",layout="Right",offset=[-688,-114],onClick="node:Parent(3):ChageTableB('PROPERTY')"
				<Image="imgAllBag",image="daoju1.png",layout="Center">
			>
			<Button="btnAllBag",image="mubanweixuanzhong.png",layout="Right",offset=[-688,1],onClick="node:Parent(3):ChageTableB('OTHER')"
				<Image="imgAllBag",image="cailiao2.png",layout="Center">
			>
			
			<TableView="tbBag",type="All",layout="Center",size=[698,385],cell="vBagTableViewCell.vui",visible=1>
		>
		
		<Image="imgMuRBag",image="xiacemutiao.png",layout="Down", offset=[0,34]>

		
		
		<Image="imgCountHtBag", image="henlandi.png", layout="UpRight", offset=[-82,15], visible = 0
			<Image="imgStoreBag",image="icon_beibaogezi.png",layout="Left", offset=[-10,0], scale=1.0>
			<Text="txStoreBag",text="0",layout="Right", offset=[-20,0],color=[255,255,0], fontSize="fs_22">
		>
	>
	<Image="titleImage", image="tongyongbiaotidi.png", layout="LetfUp", offset=[124,0]
		<Image="titliText", layout="Center", offset=[5,-8]>
	>
	<Button="backBtn", image="fanhui.png", layout="UpRight", offset=[-7,5], onClick="node:Parent():doPop()">
>