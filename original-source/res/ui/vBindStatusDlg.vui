<BindStatusDlg="bindStatusDlg"
	<Image="bgImage", fit="Full", image="tongyongbeijing.jpg", touch=1>
	<Image="titleImage1", image="tongyongbiaotidi.png", layout="Up", visible=0>

	<Image="imgBackGroundBindStatus", image="tongyongbeijingkuang.png", relative="titleImage1", layout="Down", step=[0,1], offset=[0,-34]
		<Layer="lyrStep1", layout="Up", fill=[0.74,0.27]
			<Text="txStep1BindStatus", text="步骤一：输入您的身份证号码, 点击【获取验证码】您的手机将会收到验证码", fontSize=18, layout="DownLeft", offset=[0,-8], color=[100,65,17]>
		>
		<Layer="lyrStep2", layout="Down", relative="lyrStep1", step=[0,1], fill=[1,0.16]
			<Editor="edtStatusNumBindStatus", bgImage="shurukuang.png", text="", placeHolder="请输入正确的身份证号码", fontSize=22, maxLegth=16, layout="Center", size=[200,40], offset=[0,0], pFontColor=[157,119,80], align="Left", pFont="Arial", pFontSize=26>
			<Text="txStatusNumBindStatus", text="身份证号码：", layout="LeftOut", fontSize=24, relative="edtStatusNumBindStatus", offset=[-10,0], color=[85,17,0]>
			<Button="btnGetCodeBindStatus", image="genrenziliaoanniuchang.png", topImage="huoquyanzhengma.png", layout="Right", step=[1,0], offset=[12,0], relative="edtStatusNumBindStatus", onClick="node:Parent(3):onGetCodeClick()"
				<Image="imgGetCodeBindStatus", image="huoquyanzhengma.png", layout="Center">
				<Text="txtimeStatus", text="10", fontSize=24, layout="Center", visible=0>
			>
		>

		<Layer="lyrStep3", layout="Down", relative="lyrStep2", step=[0,1], fill=[0.74,0.1]
			<Text="txStep2BindStatus", text="步骤二：输入短信中的验证码, 点击【确认绑定】", fontSize=18, layout="Left", offset=[0,0], color=[100,65,17]>
		>
	
		<Layer="lyrStep4", layout="Down", relative="lyrStep3", step=[0,1], fill=[1,0.16]
			<Editor="edtCodeBindStatus", bgImage="shurukuang.png", text="", placeHolder="请输入收到的验证码", fontSize=22, maxLegth=16, layout="Center", size=[200,40], offset=[0,0], pFontColor=[157,119,80], align="Left">
			<Text="txCodeBindStatus", text="验证码：", layout="LeftOut", fontSize=24, relative="edtCodeBindStatus", offset=[-10,0], color=[85,17,0]>
		>

		<Button="btnOKBindStatus", image="anniu7.png", layout="Down", relative="lyrStep4", step=[0,1.5], offset=[0,-10], onClick="node:Parent(2):onOKClick()"
			<Image="imgOKBindStatus", image="querenbangding.png", layout="Center">
		>


	>

	<Image="imgzhubiaotouBindStatus", image="tongyongbiaotidi.png", layout="LetfUp", offset=[124,0]
		<Image="imgTitleTMyInfoM", layout="Center", image="shimingrenzheng.png", offset=[5,-10]>
	>
	<Button="btnCloseBindStatus", layout="RightUp", image="fanhui.png", relative="imgBackGroundBindStatus", step=[0.3,-0.5], offset=[0,0], onClick="node:Parent():onCloseClick()">
>