<TableViewCell="cardCell", size=[135,315]
	<Image9="CardItem", image="kapiandi.png", layout="Center", size=[135,315]
		<Image="cardImg", image="carddiban5.png", layout="Down", offset=[0,-150], touch=1
			<Image="iconImg", image="BoomZombieL.png", layout="Down", offset=[0,-40], fit=[-0.7,-0.7]>
			<Image="starImg", image="kapaixingxing.png", layout="LeftUp", offset=[5,3]>
			<Text="starLevel", text="99", font="cardNumber.fnt", color=[255,236,108], layout="RightOut", relative="starImg", offset=[0,8]>
			
			<Image="kalouImg", image="kabeilou.png", layout="Down"
				<Text="nameText", text="僵尸", layout="Center", fontSize=14, offset=[0,-2]>
			>
		>
		<Image="suitBgImage", image="shuzibeijing.png", layout="DownOut", offset=[0,8], relative="cardImg"
			<Image="suitIcon", image="suipian.png", layout="Left", fit=[0,-0.8], offset=[10,0]>
			<Text="suitNeedText", text="/10", layout="Right", offset=[-10,0], fontSize=18, color=[85,66,40]>
			<Text="suitText", text="5", layout="LeftOut",  fontSize=18, relative="suitNeedText">
		>
		<Button="composeBtn", image="lvsetongyonganniu.png", layout="DownOut", offset=[0,8], topImage="hechengzi.png", relative="suitBgImage">
		<Button="changeStuffBtn", image="huangsetongyonganniu.png", topImage="cailiaozhuanhuazi.png", layout="DownOut", offset=[0,8], relative="composeBtn">
	>
>