<EventEntryWebDlg="eventEntryWebDlg", fill="Full"
	<Image="bgImage", fit="Full", image="tongyongbeijing.jpg">
	<Image="centerImage", image="tongyongbeijingkuang.png", layout="Center", offset=[0,8]>
	<Image="titleImage", image="tongyongbiaotidi.png", layout="LetfUp", offset=[124,0]
		<Image="titliText", image="jingcaihuodong.png", layout="Center", offset=[5,-12]>
	>
	<Button="backBtn", image="fanhui.png", layout="UpRight", offset=[-7,5], onClick="node:Parent(1):closeView()">

	<Button="rechargeBtn", image="event_chongzhi.png", layout="LeftOut", relative="backBtn", offset=[-15, -18], onClick="node:Parent(1):doCharge()">
>