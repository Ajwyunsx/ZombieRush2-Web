		>
	
<Image9="imgptbplotteryDlg", layout="Center", image="zhiwuchoukadi1.png", step=[-1,0],offset=[-61, 35], touch=1,onClick="node:Parent():Lottery('pt')"
		<Text="txDesc1ptbplotteryDlg", text="随机出一张卡牌", layout="UpOut", fontSize="fs_22", offset=[0, -17], color={0,255,255}>
		<Text="txDesc2ptbplotteryDlg", text="普通包", layout="Center", visible=0>
		
		
		<Image9="btnptbBuy", layout="DownOut", image="choukadi.png", offset=[-11,-8]
		<Text="txDesc3ptbplotteryDlg", text="随机抽取植物卡", layout="Up", fontSize="fs_22", color=[255,255,0], offset=[0, -6]>
			<Button="btnhhbBuy",image="choukaanniu.png",layout="Down",offset=[0,-6], onClick="node:Parent(3):Lottery('pt')"
				<Image="imgptbCurrenyIcon", layout="Left", offset=[36, -4], image="icon_zuanshi.png", scale=0.8>
				<Text="txptbCurrenyValue", layout="RightOut", relative="imgptbCurrenyIcon", offset=[5,2], text="0", fontSize="fs_22">
				<Image="imgptbCurrenyValue", layout="RightOut", relative="txptbCurrenyValue", offset=[5,-3], image="coukagoumai.png", visible=0>
				<Image="imgptbFreeIcon", layout="Center", image="mianfeigoumai.png", scale=0.8, visible=0>
			>
		>
	>
	<Image9="imghhbplotteryDlg", layout="Center", image="zhiwuchoukadi2.png",offset=[11, 35], touch=1,onClick="node:Parent():Lottery('hh')"
		<Text="txDesc1hhbplotteryDlg", text="必出蓝色或蓝以上卡牌", fontSize="fs_22", layout="UpOut", offset=[0, -17], color={0,255,255}>
		<Text="txDesc2hhbplotteryDlg", text="豪华包", layout="Center", visible=0>
		
		
		<Image9="imghhbCurreny", layout="DownOut", image="choukadi.png", offset=[-16,-6]
		<Text="txDesc3hhbplotteryDlg", text="豪华包必出紫卡", layout="Up", fontSize="fs_22", color=[255,255,0], offset=[0, -6]>
