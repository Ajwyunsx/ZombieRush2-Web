				<Image="imghhbFreeIcon", layout="Center", image="mianfeigoumai.png", scale=0.8, visible=0>
			>
		>
	>
	<Image9="imgthbplotteryDlg", layout="Center", image="zhiwuchoukadi3.png", step=[1,0],offset=[59, 35], touch=1, onClick="node:Parent():Lottery('th')"
